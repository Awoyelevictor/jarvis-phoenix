# ULTRON cloud configuration
# One OpenRouter key powers chat/reasoning. Keep the real value in Render secrets.
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
PHOENIX_CLOUD_BASE_URL=https://openrouter.ai/api/v1
PHOENIX_CLOUD_MODEL=openrouter/free

# SONIVOX is the single speech-generation provider/key.
# The current adapter posts to {SONIVOX_API_URL}/speak with X-API-Key.
SONIVOX_API_URL=https://YOUR-SONIVOX-API-HOST
SONIVOX_API_KEY=YOUR_SONIVOX_API_KEY

# Optional microphone transcription. This remains separate from chat/TTS.
# Configure only if Gemini transcription is enabled in your deployment.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
ULTRON_GEMINI_STT_MODEL=gemini-3.5-flash-lite
