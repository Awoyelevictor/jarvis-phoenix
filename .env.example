# ULTRON Qwen3-TTS voice engine (set real values only in your private runtime environment)
ULTRON_VOICE_API_URL=https://YOUR-COLAB-NGROK-HOST
# Use /synthesize for the current Colab wrapper, or /v1/audio/speech for ULTRON-VOICE-ENGINE.
ULTRON_VOICE_API_PATH=/synthesize
ULTRON_VOICE_API_KEY=YOUR_PRIVATE_API_KEY
USE_QWEN_TTS=true
